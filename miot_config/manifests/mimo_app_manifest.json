{
  "_comment": "经济学论文写作助手 - MiMo 应用清单 v1.0.0",

  "identification": {
    "app_id": "econ_paper_writer",
    "package_name": "com.econ.paperwriting.mimo",
    "bundle_id": "com.econ.paperwriting.mimo.app",
    "version": "1.0.0",
    "min_api_level": 26,
    "target_api_level": 34,
    "compile_sdk": 34
  },

  "localization": {
    "name": {
      "zh_CN": "经济学论文写作助手",
      "en_US": "Economics Paper Writing Assistant",
      "zh_TW": "經濟學論文寫作助手",
      "ja_JP": "経済学論文作成アシスタント",
      "ko_KR": "경제학 논문 작성 어시스턴트"
    },
    "description": {
      "zh_CN": "专为经济学研究者设计的论文写作工具，整合文献管理、数据分析、AI智能润色和GitHub版本控制，支持跨设备无缝协作。",
      "en_US": "A professional paper writing tool for economics researchers, integrating literature management, data analysis, AI-powered editing, and GitHub version control with seamless cross-device collaboration."
    },
    "short_description": {
      "zh_CN": "让学术写作更高效",
      "en_US": "Make academic writing more efficient"
    },
    "keywords": ["经济学", "论文", "写作", "学术", "研究", "文献", "economics", "paper", "writing", "academic", "research"]
  },

  "category": {
    "primary": "productivity",
    "secondary": "research_tools",
    "family": "education"
  },

  "metadata": {
    "authors": ["allboys"],
    "website": "https://github.com/allboys/economics-paper-writing",
    "support_email": "allboys@github.com",
    "privacy_policy": "https://github.com/allboys/economics-paper-writing/blob/main/PRIVACY.md",
    "license": "MIT"
  },

  "permissions": {
    "required": [
      {
        "permission": "com.xiaomi.permission.INTERNET",
        "reason": "用于云端同步和GitHub集成"
      },
      {
        "permission": "com.xiaomi.permission.NOTIFICATION",
        "reason": "发送写作提醒和同步通知"
      },
      {
        "permission": "com.xiaomi.permission.FILE_STORAGE",
        "reason": "读写论文文件和数据"
      },
      {
        "permission": "com.xiaomi.permission.BIOMETRIC",
        "reason": "生物识别登录"
      }
    ],
    "optional": [
      {
        "permission": "com.xiaomi.permission.CALENDAR",
        "reason": "同步论文截止日期"
      },
      {
        "permission": "com.xiaomi.permission.BACKGROUND_SYNC",
        "reason": "后台自动同步数据"
      }
    ]
  },

  "screens": {
    "navigation": {
      "type": "bottom_tab",
      "tabs": [
        {
          "id": "papers",
          "icon": "document",
          "label": {"zh_CN": "论文", "en_US": "Papers"},
          "badge": false
        },
        {
          "id": "data",
          "icon": "chart",
          "label": {"zh_CN": "数据", "en_US": "Data"},
          "badge": false
        },
        {
          "id": "references",
          "icon": "book",
          "label": {"zh_CN": "文献", "en_US": "References"},
          "badge": true
        },
        {
          "id": "notes",
          "icon": "note",
          "label": {"zh_CN": "笔记", "en_US": "Notes"},
          "badge": false
        },
        {
          "id": "settings",
          "icon": "settings",
          "label": {"zh_CN": "设置", "en_US": "Settings"},
          "badge": false
        }
      ]
    },
    "routes": [
      {
        "id": "main",
        "type": "tab",
        "path": "/main",
        "component": "MainTabs"
      },
      {
        "id": "paper_editor",
        "type": "fullscreen",
        "path": "/paper/:id",
        "component": "PaperEditor",
        "features": ["markdown_preview", "latex_preview", "word_count"]
      },
      {
        "id": "paper_preview",
        "type": "modal",
        "path": "/paper/:id/preview",
        "component": "PaperPreview"
      },
      {
        "id": "literature_search",
        "type": "push",
        "path": "/literature/search",
        "component": "LiteratureSearch",
        "features": ["ai_recommendation", "citation_insert"]
      },
      {
        "id": "data_import",
        "type": "push",
        "path": "/data/import",
        "component": "DataImport",
        "supported_formats": ["csv", "xlsx", "dta", "sav"]
      },
      {
        "id": "figure_generator",
        "type": "push",
        "path": "/data/visualize",
        "component": "FigureGenerator",
        "features": ["chart_types", "export_options"]
      },
      {
        "id": "settings",
        "type": "push",
        "path": "/settings",
        "component": "Settings",
        "sections": ["account", "sync", "ai", "appearance", "about"]
      },
      {
        "id": "sync_log",
        "type": "push",
        "path": "/settings/sync",
        "component": "SyncLog"
      },
      {
        "id": "ai_assistant",
        "type": "modal",
        "path": "/ai/assistant",
        "component": "AIAssistant",
        "features": ["grammar_check", "style_suggestions", "translation"]
      }
    ]
  },

  "widgets": [
    {
      "widget_id": "recent_papers",
      "name": {"zh_CN": "最近论文", "en_US": "Recent Papers"},
      "description": {"zh_CN": "显示最近编辑的论文", "en_US": "Shows recently edited papers"},
      "size": "2x2",
      "min_size": "2x2",
      "max_size": "4x4",
      "refresh_interval": 300,
      "actions": ["open_paper", "new_paper", "quick_sync"],
      "data_source": "local",
      "preview": {
        "title": "Recent Papers",
        "items": [
          {"title": "论文标题1", "subtitle": "最后编辑: 2小时前"},
          {"title": "论文标题2", "subtitle": "最后编辑: 昨天"}
        ]
      }
    },
    {
      "widget_id": "writing_stats",
      "name": {"zh_CN": "写作统计", "en_US": "Writing Stats"},
      "description": {"zh_CN": "显示写作进度和统计数据", "en_US": "Shows writing progress and statistics"},
      "size": "4x1",
      "min_size": "2x1",
      "max_size": "4x2",
      "refresh_interval": 600,
      "metrics": [
        {"id": "word_count", "label": "今日字数", "icon": "text"},
        {"id": "streak", "label": "连续写作", "icon": "fire"},
        {"id": "completion", "label": "完成度", "icon": "progress"}
      ]
    },
    {
      "widget_id": "quick_actions",
      "name": {"zh_CN": "快捷操作", "en_US": "Quick Actions"},
      "description": {"zh_CN": "常用操作的快捷入口", "en_US": "Quick access to common actions"},
      "size": "2x1",
      "min_size": "2x1",
      "max_size": "2x2",
      "actions": [
        {"id": "new_paper", "label": "新建论文", "icon": "plus"},
        {"id": "sync", "label": "立即同步", "icon": "sync"},
        {"id": "search_lit", "label": "搜索文献", "icon": "search"}
      ]
    },
    {
      "widget_id": "ai_suggestions",
      "name": {"zh_CN": "AI 建议", "en_US": "AI Suggestions"},
      "description": {"zh_CN": "显示AI写作建议", "en_US": "Shows AI writing suggestions"},
      "size": "2x2",
      "min_size": "2x2",
      "max_size": "4x4",
      "features": ["grammar", "style", "citation"]
    }
  ],

  "automations": {
    "triggers": [
      {
        "id": "daily_reminder",
        "type": "time",
        "time": "09:00",
        "repeat": "daily",
        "conditions": ["weekday_only", "charging_recommended"]
      },
      {
        "id": "sync_on_exit",
        "type": "app_event",
        "event": "app_backgrounded",
        "delay_seconds": 30
      },
      {
        "id": "git_push",
        "type": "manual",
        "label": {"zh_CN": "Git 推送触发", "en_US": "Git Push Trigger"}
      },
      {
        "id": "deadline_approaching",
        "type": "calendar",
        "days_before": [1, 3, 7]
      }
    ],
    "actions": [
      {
        "id": "notify_pending",
        "type": "notification",
        "title": {"zh_CN": "写作提醒", "en_US": "Writing Reminder"},
        "body": {"zh_CN": "您有${count}篇论文待完善", "en_US": "You have ${count} papers to work on"}
      },
      {
        "id": "sync_data",
        "type": "sync",
        "target": "xiaomi_cloud"
      },
      {
        "id": "git_backup",
        "type": "api_call",
        "endpoint": "github",
        "operation": "commit"
      },
      {
        "id": "auto_save",
        "type": "save",
        "destination": "local",
        "interval_minutes": 5
      }
    ]
  },

  "ai_features": {
    "natural_language_processing": {
      "enabled": true,
      "priority": 1,
      "models": {
        "primary": {
          "name": "xiaomi_mimo_nlp_v2",
          "version": "2.0",
          "capabilities": ["grammar", "style", "translation", "summary"]
        },
        "fallback": {
          "name": "local_transformer",
          "offline": true
        }
      },
      "languages": ["zh_CN", "en_US", "ja_JP", "de_DE", "fr_FR"],
      "features": [
        {
          "id": "grammar_check",
          "name": {"zh_CN": "语法检查", "en_US": "Grammar Check"},
          "description": {"zh_CN": "检查论文语法错误", "en_US": "Check paper grammar errors"}
        },
        {
          "id": "style_suggestions",
          "name": {"zh_CN": "风格建议", "en_US": "Style Suggestions"},
          "description": {"zh_CN": "优化学术写作风格", "en_US": "Optimize academic writing style"}
        },
        {
          "id": "academic_phrasing",
          "name": {"zh_CN": "学术表达", "en_US": "Academic Phrasing"},
          "description": {"zh_CN": "提供学术用语建议", "en_US": "Suggest academic phrases"}
        },
        {
          "id": "translation",
          "name": {"zh_CN": "中英互译", "en_US": "Translation"},
          "description": {"zh_CN": "中英文互译辅助", "en_US": "Chinese-English translation"}
        }
      ]
    },
    "literature_intelligence": {
      "enabled": true,
      "priority": 2,
      "features": [
        {
          "id": "citation_suggestion",
          "name": {"zh_CN": "引用建议", "en_US": "Citation Suggestion"},
          "description": {"zh_CN": "智能推荐相关引用", "en_US": "Intelligently recommend related citations"}
        },
        {
          "id": "related_works",
          "name": {"zh_CN": "相关文献", "en_US": "Related Works"},
          "description": {"zh_CN": "发现相关研究文献", "en_US": "Discover related research papers"}
        },
        {
          "id": "abstract_generation",
          "name": {"zh_CN": "摘要生成", "en_US": "Abstract Generation"},
          "description": {"zh_CN": "根据论文内容生成摘要", "en_US": "Generate abstract from paper content"}
        },
        {
          "id": "keyword_extraction",
          "name": {"zh_CN": "关键词提取", "en_US": "Keyword Extraction"},
          "description": {"zh_CN": "提取论文关键词", "en_US": "Extract paper keywords"}
        }
      ]
    },
    "data_intelligence": {
      "enabled": true,
      "priority": 3,
      "features": [
        {
          "id": "chart_recommendation",
          "name": {"zh_CN": "图表推荐", "en_US": "Chart Recommendation"},
          "description": {"zh_CN": "根据数据推荐最佳图表类型", "en_US": "Recommend best chart types for data"}
        },
        {
          "id": "statistical_test",
          "name": {"zh_CN": "统计检验建议", "en_US": "Statistical Test Suggestions"},
          "description": {"zh_CN": "推荐合适的统计检验方法", "en_US": "Recommend appropriate statistical tests"}
        },
        {
          "id": "regression_diagnostics",
          "name": {"zh_CN": "回归诊断", "en_US": "Regression Diagnostics"},
          "description": {"zh_CN": "检验回归分析假设", "en_US": "Test regression assumptions"}
        },
        {
          "id": "data_cleaning",
          "name": {"zh_CN": "数据清洗建议", "en_US": "Data Cleaning Suggestions"},
          "description": {"zh_CN": "识别并建议处理异常值", "en_US": "Identify and suggest handling outliers"}
        }
      ]
    }
  },

  "data_handling": {
    "local_storage": {
      "database": "papers.db",
      "encryption": true,
      "schema_version": 1
    },
    "cloud_sync": {
      "provider": "xiaomi",
      "region": "cn",
      "auto_sync": true,
      "sync_interval_minutes": 5,
      "conflict_resolution": "last_write_wins"
    },
    "file_formats": {
      "documents": [".md", ".tex", ".docx", ".pdf"],
      "data": [".csv", ".xlsx", ".dta", ".sav"],
      "references": [".bib", ".ris", ".enl"]
    },
    "encryption": {
      "algorithm": "AES-256-GCM",
      "key_management": "automatic"
    }
  },

  "compliance": {
    "gdpr": true,
    "ccpa": false,
    "china_dsa": true,
    "data_minimization": true,
    "right_to_deletion": true,
    "data_portability": true,
    "audit_trail": true
  },

  "analytics": {
    "enabled": true,
    "events": [
      "app_launch",
      "paper_create",
      "paper_edit",
      "paper_complete",
      "sync_success",
      "sync_failure",
      "ai_feature_use",
      "template_use",
      "export_pdf",
      "export_latex"
    ],
    "privacy": {
      "anonymous_tracking": true,
      "crash_reporting": true,
      "performance_metrics": true,
      "opt_out_available": true
    }
  }
}